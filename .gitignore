# Generated, large or private. Every entry here is something a run or an install wrote.
node_modules/
.venv/
__pycache__/
*.pyc
dist/
build/
out/

# Runs, their logs and the project's memory are runtime state, not source.
workspace/
logs/
evals/.runs/
evals/results/

# Secrets and harness state must never be committed.
.env
.harness-*
*.sb

# Screenshots at the root are generated by scripts/build_overview.py and the UI checks.
/*.png

# Local course material and the agent's own scratch directory.
.course-ref/
.freebuff/
brag-output-*/

.DS_Store

# Legacy run artifacts at the repository root (pre-dates workspace/runs).
runs/
# Generated by scripts/record_site.mjs and render_overview.mjs (7MB of binaries).
public/*.mp4

# Symlinked environments are local, never tracked.
.venv
node_modules

# Vercel CLI installed locally for the cloud runner build
.vercel-cli/
