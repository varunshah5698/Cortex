# Harness
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8000
HARNESS_WORKSPACE=workspace
# Off by default: the terminal tool is a guarded extra, not part of the normal loop.
HARNESS_ALLOW_TERMINAL=0

# Optional: local Ollama daemon used by the default roster
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Provider keys can live here instead of in the browser. A key saved through the
# workshop is stored 0600 in HARNESS_KEYS_FILE (per provider, not per roster row) and
# wins over these; the browser never keeps one. The keyring survives a roster reset.
# HARNESS_KEYS_FILE=.harness-keys.json
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HARNESS_PROVIDER_KEY=

# Browser origins allowed to call /api. Anything that is not the UI must present the
# token: HARNESS_TOKEN, or the generated .harness-token (mode 0600) when left unset.
HARNESS_ORIGINS=http://127.0.0.1:5178,http://localhost:5178
# HARNESS_TOKEN=

# Deployment. Render sets RENDER_EXTERNAL_URL automatically; another host can set this
# explicitly. Same-origin requests from this URL are treated as the UI by the API guard.
# HARNESS_PUBLIC_ORIGIN=https://cortex.example.com

# The public deployment has no website password. The API still rejects foreign browser
# origins and non-browser clients without X-Harness-Token.

# Generated pages and served runs live on this origin, not the API's, so a script a model
# wrote is never same-origin with /api. Loopback only.
HARNESS_PREVIEW_HOST=127.0.0.1
HARNESS_PREVIEW_PORT=8001

# Cost control. A run stops at whichever limit it reaches first; 0 disables a limit.
HARNESS_MAX_TOKENS=600000
HARNESS_MAX_USD=5.0
HARNESS_MAX_CALLS=0

# Wall clock. A run that reaches this may not start another model call: it ends at once
# with a `timed_out` error that lists the files already written, never as `done`.
# 0 disables the limit.
# Local models need headroom: one call at a time, a dozen calls per build.
HARNESS_MAX_SECONDS=7200

# Sampling temperature. Above 0 the provider samples, so the same prompt can produce
# different code; 0 is reproducible. Only temperature 0 can be cached.
HARNESS_TEMPERATURE=0.35

# Cache: OFF by default. Enabling it is not enough on its own — the cache only stores
# requests made at HARNESS_TEMPERATURE=0, because replaying a sampled generation would
# serve a different build than the model would write now. Set both to use it:
#   HARNESS_CACHE=1 HARNESS_TEMPERATURE=0
HARNESS_CACHE=0
HARNESS_CACHE_ENTRIES=256

# Transient provider failures (429/5xx/timeouts) are retried; auth errors never are.
# The provider's Retry-After is honoured even when it is longer than the backoff cap.
HARNESS_RETRY_ATTEMPTS=5
HARNESS_RETRY_DELAY=2.0
HARNESS_RETRY_MAX_DELAY=60

# In-flight requests per (base URL, model). Gateways with an account concurrency cap
# (River answers 429 "account_rate") are calmer at 1. 0 leaves concurrency to them.
HARNESS_PROVIDER_CONCURRENCY=0

# Runs: how many execute at once, and how many may wait for a slot. Beyond the queue
# limit the API answers 429 with Retry-After instead of accepting work it cannot run.
HARNESS_MAX_CONCURRENT_RUNS=2
HARNESS_MAX_QUEUED_RUNS=8

# Runner: the preview installs, builds and serves a finished run. These bound each step.
HARNESS_INSTALL_TIMEOUT=300
HARNESS_BUILD_TIMEOUT=300
HARNESS_BOOT_TIMEOUT=45

# Prices are USD per 1M tokens. The fallback is for a model with no row of its own: the
# charge still happens, but the model is reported as unpriced in GET /api/health and the
# live eval suite refuses to run until it has a row. A cap built on a guess is not a cap.
HARNESS_PRICE_INPUT=0.5
HARNESS_PRICE_OUTPUT=1.5
# Extra or overriding rows, matched by substring against the model name:
# HARNESS_PRICES={"my-model": [0.2, 0.8]}

# A run may not finish on a failing check. After the review's own revision pass the
# orchestrator allows HARNESS_REPAIR_ROUNDS repair rounds, then emits `error` instead of
# `done` while any deterministic check still fails. 0 disables the extra round.
HARNESS_REPAIR_ROUNDS=1

# The repair loop: the author fixes a failing check with tools (read, edit, check)
# instead of rewriting the whole file. Each step is one small provider call over a flat
# state block, so the context does not grow with the loop. The whole-file rewrite is still
# the fallback if a model cannot produce a usable tool call.
HARNESS_AGENT_LOOP=1
HARNESS_AGENT_STEPS=8
HARNESS_AGENT_CONTEXT_CHARS=12000
HARNESS_AGENT_OBSERVATION_CHARS=4000
HARNESS_AGENT_ACTIVE_FILES=2
# OpenAI-compatible providers can use native tool calls; the text protocol remains the
# fallback and the only path for Anthropic, Google and native Ollama.
HARNESS_NATIVE_TOOLS=1

# Installs, builds and model-authored servers are an `ask` decision
# (src/ai_harness/modules/permissions.py): they do not run until the request carries an
# explicit approval — the "Approve & run" button in the preview. Set to 0 only for
# unattended runs, where nothing can be approved.
HARNESS_REQUIRE_APPROVAL=1

# Containment for the processes the runner starts: writes are limited to the run workspace
# and package caches, and key stores (~/.ssh, ~/.aws, ~/.gnupg, ~/.netrc) are unreadable.
# Set to 0 only if you accept that installs and builds run with your own access.
HARNESS_SANDBOX=1

# One fallback model when the primary is hard-down after retries. Empty disables it.
# HARNESS_FALLBACK_MODEL=
# HARNESS_FALLBACK_BASE_URL=
# HARNESS_FALLBACK_KIND=openai

# Tier 4: open the served page in headless Chrome after it answers. CDP, no npm
# dependency. It clicks up to two visible buttons, so "renders but does nothing" is a
# finding. Set HARNESS_BROWSER_CHECK=0 on a machine without Chrome.
HARNESS_BROWSER_CHECK=1
HARNESS_BROWSER_INTERACT=1
HARNESS_BROWSER_TIMEOUT=30
# HARNESS_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# HARNESS_NODE=node

# Public share: a one-run origin behind a temporary tunnel, never `/api` and never the
# multi-run preview app. The API requires approval and the URL expires. The default
# provider is `cloudflared`; a custom tunnel command must contain {url}.
HARNESS_TUNNEL_TIMEOUT=30
HARNESS_SHARE_TTL=900
# HARNESS_TUNNEL_COMMAND=cloudflared tunnel --url {url} --no-autoupdate

# Per-run cloud execution: `cloud` sends the finished workspace to a separately deployed
# `ai_harness.cloud_runner` service. The token is server-to-server and never reaches the
# browser. With no URL/token the local runner is used.
HARNESS_RUNNER_MODE=local
# HARNESS_CLOUD_RUNNER_URL=https://cortex-runner.onrender.com
# HARNESS_CLOUD_RUNNER_TOKEN=
HARNESS_CLOUD_RUNNER_TIMEOUT=120

# Static/Node runs on Vercel: the CLI login on this machine is enough, or set a token for
# a headless host. The deployment is removed at HARNESS_VERCEL_TTL. Python ASGI runs fall
# back to the local runner.
HARNESS_VERCEL_BIN=vercel
HARNESS_VERCEL_TTL=3600
HARNESS_VERCEL_TIMEOUT=240
# HARNESS_VERCEL_TOKEN=
# HARNESS_VERCEL_SCOPE=
